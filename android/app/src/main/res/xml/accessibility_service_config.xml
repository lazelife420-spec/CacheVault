<?xml version="1.0" encoding="utf-8"?>
<!--
  Minimal accessibility service config. The service does not process any
  accessibility events or read window content — it exists solely to hold
  a ClipboardManager listener with background-read privileges.

  typeAll is declared so the system starts the service; events are ignored
  in onAccessibilityEvent.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeViewTextChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canRetrieveWindowContent="false"
    android:canPerformGestures="false"
    android:notificationTimeout="0"
    android:description="@string/accessibility_service_description" />
